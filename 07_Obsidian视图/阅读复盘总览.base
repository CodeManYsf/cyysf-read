filters:
  and:
    - file.hasTag("reading/daily")
    - file.ext == "md"
formulas:
  day_label: if(day, "Day " + day.toString(), "")
  updated: file.mtime.format("YYYY-MM-DD")
properties:
  date:
    displayName: 日期
  book:
    displayName: 书籍
  formula.day_label:
    displayName: 实践日
  core_sentence:
    displayName: 一句话沉淀
  formula.updated:
    displayName: 更新
views:
  - type: table
    name: 每日回收
    order:
      - file.name
      - date
      - book
      - formula.day_label
      - core_sentence
      - formula.updated
